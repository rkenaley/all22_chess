{
  "name": "all22_chess",
  "version": "1.0.0",
  "description": "High-Speed Continuous Game-Theoretic Football Simulation & Adversarial Co-Evolution Lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
