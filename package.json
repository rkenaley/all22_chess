{
  "name": "all22_chess",
  "version": "1.0.0",
  "description": "High-Speed Continuous Game-Theoretic Football Simulation & Adversarial Co-Evolution Lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "simulate:optimum": "npx tsx src/simulate_pet_optimum.ts",
    "benchmark": "npx tsx src/benchmark_audit.ts",
    "evolve:schemes": "npx tsx src/evolve_running_schemes.ts",
    "analyze:counters": "npx tsx src/analyze_defensive_counters.ts",
    "analyze:personnel": "npx tsx src/analyze_personnel_sensitivity.ts",
    "simulate:vanguard2027": "npx tsx src/vanguard_2027_playtest.ts",
    "generate:cards": "npx tsx src/generate_twitter_cards.ts",
    "simulate:argon2027": "npx tsx src/argon_2027_playtest.ts",
    "simulate:apex2027": "npx tsx src/apex_2027_playtest.ts",
    "generate:argon-cards": "npx tsx src/generate_argon_cards.ts",
    "generate:gifs": "npx tsx src/generate_play_gifs.ts",
    "generate:apex-gifs": "npx tsx src/generate_apex_gifs.ts",
    "build:apex-html": "npx tsx src/build_apex_whitepaper_html.ts",
    "validate:tracking": "npx tsx src/validate_10hz_replay.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
