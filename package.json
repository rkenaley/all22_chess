    "analyze:qb": "npx tsx src/analyze_qb_archetype_sensitivity.ts",
    "analyze:dualqb": "npx tsx src/analyze_read3_scramble_and_dual_qb.ts",
    "analyze:nash2qb": "npx tsx src/run_dual_qb_nash_tournament.ts",
    "simulate:season": "npx tsx src/simulate_4down_season.ts",
    "analyze:sequencing": "npx tsx src/analyze_play_sequencing_memory.ts",
    "analyze:pareto60": "npx tsx src/analyze_pareto_60pct_cap.ts",
    "analyze:components": "npx tsx src/analyze_win_components_5groups.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
