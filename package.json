    "test:realism": "npx tsx src/test_realism_and_defensive_psychology.ts",
    "test:voronoi": "npx tsx src/test_voronoi_coverage.ts",
    "audit:realism": "npx tsx src/run_post_fix_realism_audit.ts",
    "simulate:vanguard2027": "npx tsx src/vanguard_2027_playtest.ts",
    "generate:cards": "npx tsx src/generate_twitter_cards.ts",
    "simulate:argon2027": "npx tsx src/argon_2027_playtest.ts",
    "simulate:apex2027": "npx tsx src/apex_2027_playtest.ts",
    "simulate:ultimate2027": "npx tsx src/ultimate_2027_playtest.ts",
    "generate:argon-cards": "npx tsx src/generate_argon_cards.ts",
