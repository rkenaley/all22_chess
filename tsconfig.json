{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/main.ts",
    "src/engine.ts",
    "src/renderer.ts",
    "src/theme.ts",
    "src/route_presets.ts",
    "src/canonical_baselines.ts",
    "src/vanguard_2027_playbook.ts",
    "src/argon_2027_playbook.ts",
    "src/apex_2027_playbook.ts",
    "src/bistable_packaged_playbook.ts",
    "src/ultimate_2027_offense.ts",
    "src/ultimate_2027_playtest.ts",
    "src/validate_10hz_replay.ts",
    "src/trial_nfl_benchmarks.ts",
    "src/test_realism_and_defensive_psychology.ts",
    "src/test_voronoi_coverage.ts",
    "src/analyze_qb_archetype_sensitivity.ts",
    "src/analyze_read3_scramble_and_dual_qb.ts",
    "src/run_dual_qb_nash_tournament.ts",
    "src/simulate_4down_season.ts"
  ],
  "exclude": [
    "src/legacy_v1"
  ]
}
